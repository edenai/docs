# Eden AI test configuration
# Copy to .env and fill in values:  cp .env.example .env

# Sandbox token — used for most snippet tests (AI feature calls return mock responses)
EDEN_AI_SANDBOX_API_TOKEN=your_sandbox_token_here

# Production token: needed by the few pages whose samples require real provider
# responses (e.g. structured output). Optional: those tests are skipped if not set
EDEN_AI_PRODUCTION_API_TOKEN=your_api_token_here

# Management key (mgmt-eden-...) with manage:read and manage:write, needed by the
# Management API samples (custom API keys, sandbox key creation, monitoring).
# They mint real inference keys in the key's organization; the run revokes what it
# created. Optional: those tests are skipped if not set
EDEN_AI_MANAGEMENT_KEY=your_management_key_here

EDEN_AI_BASE_URL=https://staging-api.edenai.run

# --- Evals pipeline (tests/evals/) ---
# The LLM judge reuses EDEN_AI_PRODUCTION_API_TOKEN above.

# Mintlify API key — needed for first eval run to fetch Ask AI answers
# Optional after first run (answers are cached to tests/evals/.cache/)
MINTLIFY_API_KEY=mint_dsc_your_key_here

# Optional: override the judge model (default: openai/gpt-4o)
# EVAL_JUDGE_MODEL=openai/gpt-4o-mini
